[Unit]
Description=Chrome on display :0
After=openbox.service
Requires=xvfb.service

[Service]
User=agent
Environment=DISPLAY=:0
Environment=HOME=/home/agent
# Chrome wants a runtime dir; without one it emits errors and can fail to start
# under a system unit that has no user session.
Environment=XDG_RUNTIME_DIR=/run/agent-runtime
RuntimeDirectory=agent-runtime
RuntimeDirectoryMode=0700
# --user-data-dir is NOT the default path on purpose. Since Chrome 136,
# --remote-debugging-port is silently ignored on the default profile dir: the
# port accepts connections, /json/version 404s, and DevToolsActivePort is never
# written. This path is non-default but persisted (it sits on the /dev/vdb
# overlay), so logins survive delete and recreate.
# --password-store=basic pins plaintext os_crypt. The VM has no keyring today so
# Chrome falls back to it anyway, but a future apt install could pull one in and
# silently make every existing profile undecryptable.
# Chrome's SingletonLock is a symlink holding "<ip-or-hostname>-<pid>". The guest
# IP comes from the VM's slot (internal/hostnet/tap.go SlotAddrs), so a VM that
# comes back in a DIFFERENT slot reads a lock naming an address that is not this
# machine, concludes another computer holds the profile, and refuses to start
# forever -- observed at NRestarts=230 with the unit stuck "activating", which
# then wedges the agent permanently while /health still reports ok.
#
# Removing them is unconditionally safe here: this unit is the only thing in the
# image that starts Chrome and systemd runs ExecStartPre to completion first, so
# anything present at this instant is stale by construction. All three, not just
# the lock -- Chrome checks the trio and a stray socket reproduces the refusal.
# The leading `-` keeps a read-only overlay from blocking Chrome entirely.
ExecStartPre=-/bin/rm -f /home/agent/chrome-profile/SingletonLock \
  /home/agent/chrome-profile/SingletonSocket \
  /home/agent/chrome-profile/SingletonCookie
ExecStart=/usr/bin/google-chrome \
  --no-sandbox \
  --disable-dev-shm-usage \
  --user-data-dir=/home/agent/chrome-profile \
  --password-store=basic \
  --remote-debugging-port=9222 \
  --remote-debugging-address=127.0.0.1 \
  --no-first-run \
  --no-default-browser-check \
  --disable-features=Translate,MediaRouter \
  --start-maximized \
  about:blank
# Chrome must exit cleanly or the profile's LevelDB tears mid-write and saved
# logins are lost. The host teardown ladder allows 20s for this.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=5
# Chrome's stderr goes to the serial console so the host can read boot failures
# out of run/<vm>/console.log. The console writer is size-capped host-side.
StandardOutput=journal+console
StandardError=journal+console
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
