#
# From firecracker-containerd tools/image-builder/files_debootstrap/sbin/overlay-init
# with a defensive /proc + /dev preamble added: `docker export` drops device
# nodes, so without an auto-mounting kernel this would panic on /dev/vdb with
# no usable diagnostic.

mount -t proc     proc     /proc 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev  2>/dev/null || true

# Parameters:
# 1. rw_root -- path where the read/write root is mounted
# 2. work_dir -- path to the overlay workdir (must be on same filesystem as rw_root)
# Overlay will be set up on /mnt, original root on /mnt/rom
# panic prints a diagnosable message to the serial console and stops the boot.
panic() {
    echo "FATAL: overlay-init: $*"
    exit 1
}

pivot() {
    local rw_root work_dir
    rw_root="$1"
    work_dir="$2"
    /bin/mount \
	-o noatime,lowerdir=/,upperdir=${rw_root},workdir=${work_dir} \
	-t overlay "overlayfs:${rw_root}" /mnt
    pivot_root /mnt /mnt/rom
}

# Overlay is configured under /overlay
# Global variable $overlay_root is expected to be set to either:
# "ram", which configures a tmpfs as the rw overlay layer (this is
# the default, if the variable is unset)
# - or -
# A block device name, relative to /dev, in which case it is assumed
# to contain an ext4 filesystem suitable for use as a rw overlay
# layer. e.g. "vdb"
do_overlay() {
    local overlay_dir="/overlay"
    [ -d "$overlay_dir" ] || panic "$overlay_dir does not exist in the rootfs image"
    if [ "$overlay_root" = ram ] ||
           [ -z "$overlay_root" ]; then
        /bin/mount -t tmpfs -o noatime,mode=0755 tmpfs /overlay ||
            panic "failed to mount tmpfs on $overlay_dir"
    else
        /bin/mount -t ext4 "/dev/$overlay_root" /overlay ||
            panic "failed to mount /dev/$overlay_root on $overlay_dir"
    fi
    mkdir -p /overlay/root /overlay/work ||
        panic "failed to create upperdir/workdir under $overlay_dir"
    pivot /overlay/root /overlay/work
}

# If we're given an overlay, ensure that it really exists. Panic if not.
if [ -n "$overlay_root" ] &&
       [ "$overlay_root" != ram ] &&
       [ ! -b "/dev/$overlay_root" ]; then
    echo -n "FATAL: "
    echo "Overlay root given as $overlay_root but /dev/$overlay_root does not exist"
    exit 1
fi

do_overlay

# Refuse to continue on a read-only root. Falling through here is what makes a
# broken overlay look like a healthy VM: systemd boots, the agent answers, and
# nothing persists. Exiting from PID 1 panics the kernel, and with panic=1 that
# terminates firecracker, so the control plane reports the boot as failed.
[ -d /rom/etc ] || panic "pivot_root did not take; refusing to boot read-only"

# invoke the actual system init program and procede with the boot
# process.
exec /sbin/init $@
