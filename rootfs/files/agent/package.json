{
  "name": "cracked-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-templates": "mkdir -p dist/memory/templates && cp -R src/memory/templates/. dist/memory/templates/",
    "build": "tsc -p tsconfig.json && npm run copy-templates",
    "pretest": "tsc -p tsconfig.test.json && mkdir -p .testbuild/src/memory/templates && cp -R src/memory/templates/. .testbuild/src/memory/templates/",
    "test": "node --test \".testbuild/test/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.238",
    "@anthropic-ai/sdk": ">=0.93.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chrome-devtools-mcp": "^1.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
