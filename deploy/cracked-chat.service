[Unit]
Description=Chat UI for cracked VM agents
After=network-online.target cracked.service
Wants=network-online.target

[Service]
User=cracked
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# Both listeners bind loopback: only Caddy can reach them, so a security-group
# mistake cannot expose the app or the VNC gateway.
Environment=CHAT_ADDR=127.0.0.1:8090
Environment=CHAT_VNC_ADDR=127.0.0.1:8091
Environment=CHAT_ORIGIN=https://chat.usetypeo.com
Environment=CHAT_VNC_ORIGIN=https://vnc.usetypeo.com
Environment=CRACKED_URL=http://127.0.0.1:8080
# The Supabase project whose public keys verify every /v1 access token. Not a
# secret -- it is the same URL the app ships with -- so it lives here.
Environment=SUPABASE_URL=https://vpjsckvgqodzsbxuceau.supabase.co
# CRACKED_TOKEN via `systemctl edit cracked-chat`, never in this file.
# FEEDBACK_WEBHOOK_URL goes the same way: the Apps Script /exec URL is a bearer
# credential. See deploy/feedback-sheet.gs. Unset just turns feedback off.

ExecStart=/usr/local/bin/cracked-chat
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
